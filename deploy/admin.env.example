# Copy into a private server secret file, chmod 600, and replace every placeholder.
# This example is not deployable. Do not commit populated values or print resolved Compose config.
ADMIN_IMAGE=registry.example.invalid/zephium-admin@sha256:REPLACE_WITH_REVIEWED_DIGEST
ADMIN_ORIGIN=https://admin-staging.example.invalid
ADMIN_AUTH_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
ADMIN_AUTH_DATABASE_URL=postgres://zephium_admin_auth:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/zephium
ADMIN_READ_DATABASE_URL=postgres://zephium_admin_report:REPLACE_WITH_DIFFERENT_URL_ENCODED_PASSWORD@postgres:5432/zephium
ADMIN_DATABASE_NETWORK=REPLACE_WITH_EXISTING_STAGING_DATABASE_NETWORK
ADMIN_PROXY_NETWORK=REPLACE_WITH_EXISTING_STAGING_PROXY_NETWORK
ADMIN_PROXY_ALIAS=zephium-dashboard-staging
# Trust the observed immediate reverse proxy, never an entire unverified network.
ADMIN_TRUSTED_PROXY_CIDRS=
# Set only when the verified trusted forwarding chain actually includes Cloudflare.
ADMIN_TRUSTED_CLOUDFLARE_CIDRS=
# Display-only monthly-equivalent prices for MRR, in minor units: plan:interval=amount.
ADMIN_PLAN_PRICES=pro:monthly=2000,max:monthly=10000
# Optional, transient operation only. Normal admin startup does not need this credential.
# ADMIN_MIGRATOR_DATABASE_URL=postgres://zephium_migrator:REPLACE@postgres:5432/zephium

# Optional Cloudflare Access perimeter. Configure before exposing a protected origin.
# Values are nonsecret; never substitute a user JWT or service token here.
ADMIN_ACCESS_MODE=off
ADMIN_ACCESS_ISSUER=
ADMIN_ACCESS_AUDIENCE=
ADMIN_ACCESS_EMAILS=

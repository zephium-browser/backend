# TEMPLATE ONLY. Store filled values outside Git or in Coolify environment secrets.
# Use separate production accounts/keys; never copy staging secrets. Generate random secrets independently (at least 32 chars).
ZEPHIUM_ACCOUNT_IMAGE=
ZEPHIUM_WORKER_IMAGE=
ZEPHIUM_POSTGRES_IMAGE=
# Use the dedicated application network shared only with its reverse proxy.
# In Coolify this is the application UUID network, not the shared coolify network.
ZEPHIUM_PROXY_NETWORK=
# Policy: create the managed File zephium-production-policy.json; start with enabled:false.
# Required host file: /etc/zephium/backups/pgbackrest.conf (read-only bind mount).
# Install with the PostgreSQL image UID/GID and mode 0600. Verify a restore before launch.
POSTGRES_OWNER_PASSWORD=
ZEPHIUM_MIGRATOR_PASSWORD=
ZEPHIUM_APP_PASSWORD=
# URL-encode passwords; role passwords and URLs must match.
ZEPHIUM_MIGRATOR_DATABASE_URL=postgres://zephium_migrator:REPLACE@postgres:5432/zephium
ZEPHIUM_APP_DATABASE_URL=postgres://zephium_app:REPLACE@postgres:5432/zephium
API_ORIGIN=https://api.zephium.app
TRUSTED_ORIGINS=https://api.zephium.app
# Fill only after observing the proxy address/subnet seen by the API.
TRUSTED_PROXY_CIDRS=
# Optional Cloudflare edge CIDRs, separate from the directly trusted Coolify proxy.
TRUSTED_CLOUDFLARE_CIDRS=
AUTH_SECRET=
ABUSE_SECRET=
ELIGIBILITY_SECRET=
EMAIL_FROM=
RESEND_API_KEY=
SOURCE_URL=
# Oldest supported desktop build; prereleases sort before the stable release.
CLIENT_MIN_VERSION=1.0.0-beta.2
OPERATIONS_WEBHOOK=
# Keep enrollment closed through qualification. At launch: SIGNUP_OPEN=true and empty allowlist.
SIGNUP_OPEN=false
SIGNUP_EMAIL_ALLOWLIST=
SIGNUP_PER_IP_PER_DAY=3
# Shared OTP delivery limits, across API replicas. IPv6 send buckets use /64.
OTP_SENDS_PER_NETWORK_PER_15_MIN=30
EMAIL_SENDS_PER_MINUTE=300
EMAIL_MAX_IN_FLIGHT=4
BILLING_ENABLED=false
# compose.production.yaml fixes POLAR_ENVIRONMENT=production. Use separate production credentials.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=
BILLING_RETURN_URL=
CLOUD_OPENAI_KEY=
CLOUD_ANTHROPIC_KEY=
CLOUD_GOOGLE_KEY=
CLOUD_OPENROUTER_KEY=
CLOUD_DEEPSEEK_KEY=
CLOUD_TYPESAFE_KEY=

# Optional Linux release waitlist. Enable only after the confirmation page and staging check.
WAITLIST_ENABLED=false
WAITLIST_WEB_ORIGIN=https://zephium.app
WAITLIST_EMAILS_PER_MINUTE=30
WAITLIST_EMAILS_PER_DAY=1000

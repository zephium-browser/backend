# TEMPLATE ONLY. Store filled values outside Git or in Coolify environment secrets.
# Use separate staging accounts/keys. Generate random secrets independently (at least 32 chars).
ZEPHIUM_ACCOUNT_IMAGE=
ZEPHIUM_WORKER_IMAGE=
ZEPHIUM_POSTGRES_IMAGE=
# Use the dedicated application network shared only with its reverse proxy.
# In Coolify this is the application UUID network, not the shared coolify network.
ZEPHIUM_PROXY_NETWORK=
# Policy: create the Compose-managed File zephium-staging-policy.json with reviewed JSON.
# Required only with compose.staging-backups.yaml; base staging is disposable.
ZEPHIUM_PGBACKREST_CONFIG_FILE=
POSTGRES_OWNER_PASSWORD=
ZEPHIUM_MIGRATOR_PASSWORD=
ZEPHIUM_APP_PASSWORD=
# URL-encode passwords; role passwords and URLs must match.
ZEPHIUM_MIGRATOR_DATABASE_URL=postgres://zephium_migrator:REPLACE@postgres:5432/zephium
ZEPHIUM_APP_DATABASE_URL=postgres://zephium_app:REPLACE@postgres:5432/zephium
API_ORIGIN=https://staging-api.zephium.app
TRUSTED_ORIGINS=https://staging-api.zephium.app
# Fill only after observing the proxy address/subnet seen by the API.
TRUSTED_PROXY_CIDRS=
AUTH_SECRET=
ABUSE_SECRET=
ELIGIBILITY_SECRET=
EMAIL_FROM=
RESEND_API_KEY=
SOURCE_URL=
# Oldest supported desktop build; prereleases sort before the stable release.
CLIENT_MIN_VERSION=1.0.0-beta.2
OPERATIONS_WEBHOOK=
# Enrollment stays closed until exact staging testers are configured.
SIGNUP_OPEN=false
SIGNUP_EMAIL_ALLOWLIST=
BILLING_ENABLED=false
# compose.staging.yaml fixes POLAR_ENVIRONMENT=sandbox. Never enter production Polar keys.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=
BILLING_RETURN_URL=
CLOUD_OPENAI_KEY=
CLOUD_ANTHROPIC_KEY=
CLOUD_GOOGLE_KEY=
CLOUD_OPENROUTER_KEY=
CLOUD_DEEPSEEK_KEY=
CLOUD_TYPESAFE_KEY=

# Optional single-step Linux release waitlist.
WAITLIST_ENABLED=false
WAITLIST_WEB_ORIGIN=https://zephium.app
WAITLIST_REQUESTS_PER_MINUTE=30
WAITLIST_REQUESTS_PER_DAY=1000

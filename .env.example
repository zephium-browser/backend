NODE_ENV=development
DEPLOYMENT_MODE=hosted
SIGNUP_OPEN=true
# Empty permits all addresses; restrict staging to exact comma-separated testers.
SIGNUP_EMAIL_ALLOWLIST=
SIGNUP_PER_IP_PER_DAY=3
BLOCK_DISPOSABLE_EMAIL=true
DISPOSABLE_EMAIL_DOMAINS_FILE=config/disposable-email-domains.txt
CLIENT_MIN_VERSION=1.0.0
CLIENT_NOTICE_ID=
CLIENT_NOTICE_TEXT=
CLIENT_NOTICE_SEVERITY=info
# Public corresponding-source URL for the deployed release/fork.
SOURCE_URL=
# Stable, independent secret for grant eligibility; keep in backup/recovery custody.
ELIGIBILITY_SECRET=
PORT=3000
API_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=
DATABASE_URL=postgres://zephium:local-development-only@127.0.0.1:5432/zephium
DB_POOL_SIZE=10
DATABASE_CA_FILE=
# Replace with independently generated random secrets before running.
AUTH_SECRET=
ABUSE_SECRET=
RESEND_API_KEY=
# Shared bound for sign-in and account-action sends; rejects excess work without queuing.
# Shared OTP delivery limits, across API replicas. IPv6 send buckets use /64.
OTP_SENDS_PER_NETWORK_PER_15_MIN=30
EMAIL_SENDS_PER_MINUTE=300
EMAIL_MAX_IN_FLIGHT=16
OPERATIONS_WEBHOOK=
EMAIL_FROM=Zephium <login@auth.zephium.app>
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_WEBHOOK_FORMAT=standard
POLAR_ENVIRONMENT=sandbox
BILLING_ENABLED=false
POLAR_MONTHLY_PRODUCT_ID=
POLAR_YEARLY_PRODUCT_ID=
BILLING_SUCCESS_URL=https://zephium.app/billing/return
BILLING_RETURN_URL=https://zephium.app/billing/return
CLOUD_CONFIG_PATH=config/cloud.json
CLOUD_OPENAI_KEY=
CLOUD_ANTHROPIC_KEY=
CLOUD_GOOGLE_KEY=
CLOUD_OPENROUTER_KEY=
CLOUD_DEEPSEEK_KEY=
CLOUD_TYPESAFE_KEY=

# Optional Linux release waitlist. Enable only after the confirmation page and staging check.
WAITLIST_ENABLED=false
WAITLIST_WEB_ORIGIN=https://zephium.app
WAITLIST_EMAILS_PER_MINUTE=30
WAITLIST_EMAILS_PER_DAY=1000
